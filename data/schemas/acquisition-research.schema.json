{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dewly.local/schemas/acquisition-research.schema.json",
  "title": "Additive acquisition research catalogue (not a complete runtime graph)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameVersion", "scope", "records", "sourceFile"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "gameVersion": {"type": "string", "minLength": 1},
    "scope": {"type": "string"},
    "sourceFile": {"type": "string"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "qualifiedItemId", "routes"],
        "properties": {
          "id": {"type": "string", "pattern": "^acq\\.item\\."},
          "qualifiedItemId": {"type": "string", "pattern": "^\\(O\\)"},
          "routes": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "type", "verification", "evidenceIds", "sourceRefs", "recursivePrerequisitesResolved"],
              "properties": {
                "id": {"type": "string", "pattern": "^acq\\.method\\."},
                "type": {"type": "string", "minLength": 1},
                "verification": {"const": "external-research"},
                "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence\\.research\\.acquire(?:2|3)?\\."}},
                "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
                "recursivePrerequisitesResolved": {"const": false},
                "prerequisites": {"type": "array", "items": {"$ref": "#/$defs/prerequisite"}},
                "inputItems": {"type": "array", "items": {"$ref": "#/$defs/input"}},
                "sourceAcquisitionAlternatives": {"type": "array", "items": {"type": "object", "properties": {
                    "prerequisites": {"type": "array", "items": {"$ref": "#/$defs/prerequisite"}},
                    "inputItems": {"type": "array", "items": {"$ref": "#/$defs/input"}}
                }}},
                "serviceCostGold": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "prerequisite": {"type": "object", "required": ["ref"], "properties": {"ref": {"type": "string", "pattern": "^acq\\.prereq\\."}}},
    "input": {"type": "object", "properties": {"itemId": {"type": "string", "pattern": "^\\(O\\)"}, "quantity": {"type": "number", "exclusiveMinimum": 0}}}
  }
}
